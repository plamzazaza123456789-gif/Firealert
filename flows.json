    {
        "id": "b98bdb778165f360",
        "type": "ui_template",
        "z": "549c14d9d83c03b0",
        "group": "d1b4597a2738e679",
        "name": "",
        "order": 0,
        "width": 0,
        "height": 0,
        "format": "<div class=\"dashboard-container\">\n    <h2>🔥 FIRE & GAS MONITOR</h2>\n\n    <!-- การ์ดแสดงค่าเซนเซอร์ -->\n    <div class=\"sensor-grid\">\n        <div class=\"card\">\n            <div class=\"title\">GAS LEVEL</div>\n            <div class=\"value\" ng-style=\"{'color': (msg.payload.gas > 1000) ? '#ff3333' : '#00ffcc'}\">\n                {{ msg.payload.gas || 0 }}\n            </div>\n        </div>\n        <div class=\"card\">\n            <div class=\"title\">FLAME STATUS</div>\n            <div class=\"value\" ng-style=\"{'color': (msg.payload.flame === 0) ? '#ff3333' : '#00ffcc'}\">\n                {{ msg.payload.flame === 0 ? 'FIRE!' : 'NORMAL' }}\n            </div>\n        </div>\n    </div>\n\n    <!-- กล่องแจ้งเตือน DANGER สีแดงกะพริบกลางจอ (แสดงอัตโนมัติเมื่ออันตราย) -->\n    <div ng-if=\"msg.payload.gas > 1000 || msg.payload.flame === 0\" class=\"danger-banner\">\n        <div class=\"danger-content\">\n            <h1>⚠️ DANGER ⚠️</h1>\n            <p>CRITICAL FIRE OR GAS HAZARD DETECTED!</p>\n        </div>\n    </div>\n</div>\n\n<style>\n    .dashboard-container {\n        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n        background-color: #0f172a;\n        color: #f8fafc;\n        padding: 20px;\n        border-radius: 12px;\n        position: relative;\n        overflow: hidden;\n        border: 1px solid #1e293b;\n    }\n\n    h2 {\n        text-align: center;\n        margin-top: 0;\n        color: #38bdf8;\n        font-size: 16px;\n        letter-spacing: 1px;\n        margin-bottom: 15px;\n    }\n\n    .sensor-grid {\n        display: flex;\n        gap: 10px;\n        justify-content: center;\n    }\n\n    .card {\n        background: #1e293b;\n        border: 1px solid #334155;\n        padding: 15px;\n        border-radius: 8px;\n        text-align: center;\n        flex: 1;\n    }\n\n    .title {\n        font-size: 10px;\n        color: #94a3b8;\n        letter-spacing: 1px;\n        margin-bottom: 5px;\n        font-weight: bold;\n    }\n\n    .value {\n        font-size: 20px;\n        font-weight: bold;\n        font-family: monospace;\n    }\n\n    /* กล่องแดง DANGER */\n    .danger-banner {\n        position: absolute;\n        top: 0;\n        left: 0;\n        right: 0;\n        bottom: 0;\n        background: rgba(220, 38, 38, 0.95);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        border-radius: 12px;\n        animation: pulse-danger 0.8s infinite alternate;\n        z-index: 99;\n    }\n\n    .danger-content {\n        text-align: center;\n        color: white;\n    }\n\n    .danger-content h1 {\n        font-size: 32px;\n        margin: 0 0 5px 0;\n        letter-spacing: 2px;\n        text-shadow: 0 0 10px rgba(0, 0, 0, 0.8);\n    }\n\n    .danger-content p {\n        font-size: 12px;\n        margin: 0;\n        font-weight: 600;\n    }\n\n    @keyframes pulse-danger {\n        0% {\n            background: rgba(220, 38, 38, 0.85);\n        }\n\n        100% {\n            background: rgba(239, 68, 68, 0.98);\n            box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.6);\n        }\n    }\n</style>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
