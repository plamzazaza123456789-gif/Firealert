        "func": "let gas = msg.payload.gas;\nlet flame = msg.payload.flame;\n\nif (gas > 1000 || flame === 0) {\n    msg.payload = `⚠️ อันตราย! ตรวจพบความผิดปกติ - แก๊ส: ${gas}, เปลวไฟ: ${flame === 0 ? 'พบไฟ!' : 'ปกติ'}`;\n    return [msg];\n} else {\n    return null;\n}",
